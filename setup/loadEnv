#!/bin/bash
# Robust environment loader for keys

CONFIG_FILE="credentials.json"

echo "Current directory: $(pwd)"
ls -la

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Error: $CONFIG_FILE not found!"
  exit 1
fi

if ! command -v jq &> /dev/null; then
  echo "Error: 'jq' is required. Install with: sudo apt install jq"
  exit 1
fi

echo "Loading environment variables from $CONFIG_FILE"

# Use jq to output null-terminated strings for safety
while IFS= read -r -d '' key && IFS= read -r -d '' value; do
  # Remove potential carriage returns
  value=${value//$'\r'/}
  
  echo "Exporting: $key"
  export "$key"="$value"
  
  if [[ "$key" == *Key* ]]; then
    echo "  Type: ${value:0:25}"
    echo "  Length: ${#value} characters"
  fi
done < <(jq -j 'to_entries[] | .key, "\u0000", .value, "\u0000"' "$CONFIG_FILE")

echo "Environment setup complete"